<!-- Dialogs sit on their own opaque ground rather than the photo, so their
     contrast does not depend on what is behind the window. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/dialog" />
    <stroke android:width="1dp" android:color="@color/rule" />
    <corners android:radius="22dp" />
</shape>
