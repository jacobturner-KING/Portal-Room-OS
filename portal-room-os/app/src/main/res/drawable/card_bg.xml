<!-- A tappable panel that also shows where a controller's D-pad has landed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_pressed" />
            <stroke android:width="1dp" android:color="@color/rule" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_pressed" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="@color/rule" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
