<!-- Toolbar strip. Holds the controls on the calendar and transit screens so
     their labels never sit straight on the photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/bar" />
    <stroke android:width="1dp" android:color="@color/rule" />
    <corners android:radius="20dp" />
    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
</shape>
