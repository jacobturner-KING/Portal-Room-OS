    <solid android:color="@color/bar" />
    <stroke android:width="1dp" android:color="@color/rule" />
    <corners android:radius="13dp" />
    <padding android:left="14dp" android:top="5dp" android:right="14dp" android:bottom="5dp" />
</shape>
