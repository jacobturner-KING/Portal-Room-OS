<!-- Agents: every coding agent on every machine, one at a time with its pet
     acting out the work, or all at once as tiles. Tap the pet to talk to it,
     tap anywhere to send. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button android:id="@+id/backBtn" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="56dp" android:background="@drawable/button_bg" android:text="‹" android:textColor="@color/text" android:textSize="24sp" android:textAllCaps="false" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Agents"
            android:textColor="@color/text"
            android:textSize="23sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/muted"
            android:textSize="15sp" />
        <Button android:id="@+id/sortBtn" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:minWidth="150dp" android:paddingHorizontal="18dp" android:background="@drawable/button_bg" android:text="Sort: Started" android:textColor="@color/text" android:textSize="16sp" android:textAllCaps="false" />
        <Button android:id="@+id/approvalsBtn" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:paddingHorizontal="18dp" android:background="@drawable/button_bg" android:text="Approve here: off" android:textColor="@color/muted" android:textSize="16sp" android:textAllCaps="false" />
        <Button android:id="@+id/viewBtn" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="150dp" android:paddingHorizontal="18dp" android:background="@drawable/button_bg" android:text="All agents" android:textColor="@color/text" android:textSize="16sp" android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <!-- One agent: the pet on the left, what it is doing on the right. -->
        <LinearLayout
            android:id="@+id/single"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/petPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:background="@drawable/panel_flat_bg">
                <com.portalroomos.PetView
                    android:id="@+id/pet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="70dp" />
                <TextView
                    android:id="@+id/petHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="44dp"
                    android:text="Tap me to talk · swipe for the next agent"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />
                <LinearLayout
                    android:id="@+id/dots"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/details"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:layout_marginStart="10dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/agentLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/project"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text"
                    android:textSize="34sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/stateLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/accent"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/statsLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/muted"
                    android:textSize="16sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <!-- A permission prompt held for this panel. -->
                <LinearLayout
                    android:id="@+id/askRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/askText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="@color/amber"
                        android:textSize="18sp" />
                    <Button android:id="@+id/denyBtn" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_marginStart="10dp" android:minWidth="110dp" android:background="@drawable/button_bg" android:text="Deny" android:textColor="@color/alert" android:textSize="18sp" android:textAllCaps="false" />
                    <Button android:id="@+id/allowBtn" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_marginStart="10dp" android:minWidth="130dp" android:background="@drawable/button_bg" android:text="Approve" android:textColor="@color/success" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false" />
                </LinearLayout>
                <TextView
                    android:id="@+id/attention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/amber"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/promptLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="YOU ASKED"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/text"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/replyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="LAST REPLY"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <ScrollView
                    android:id="@+id/replyScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:fadeScrollbars="false">
                    <TextView
                        android:id="@+id/reply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text"
                        android:textSize="17sp" />
                </ScrollView>

                <TextView
                    android:id="@+id/sayLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <Button android:id="@+id/talkBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:background="@drawable/button_bg" android:text="🎙 Talk" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false" />
                    <Button android:id="@+id/focusBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/button_bg" android:text="Show on Mac" android:textColor="@color/text" android:textSize="17sp" android:textAllCaps="false" />
                    <Button android:id="@+id/dismissBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:layout_marginStart="10dp" android:background="@drawable/button_bg" android:text="Dismiss" android:textColor="@color/muted" android:textSize="17sp" android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Every agent at once. -->
        <ScrollView
            android:id="@+id/gridScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- No agents yet. -->
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/panel_flat_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <com.portalroomos.PetView
                android:id="@+id/emptyPet"
                android:layout_width="320dp"
                android:layout_height="320dp" />
            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="760dp"
                android:text="No agents yet"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/emptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="760dp"
                android:text="Link AppTabs on the Mac over USB or Wi-Fi, or set up a machine with portal-room-os/agents/install.mjs. Each Claude Code, Codex or Cursor session shows up here."
                android:textColor="@color/muted"
                android:textSize="17sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/chip_bg"
        android:text="Connecting…"
        android:textColor="@color/muted"
        android:textSize="13sp" />
</LinearLayout>

    <!-- Listening: the whole screen is the send button. -->
    <FrameLayout
        android:id="@+id/listening"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <!-- Laid over the details panel's button row, so it reads as that
             row turning into the listening control. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="84dp"
            android:layout_gravity="top|start"
            android:background="@drawable/dialog_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="12dp"
            android:id="@+id/listeningBar">
            <com.portalroomos.LevelMeterView
                android:id="@+id/voiceMeter"
                android:layout_width="120dp"
                android:layout_height="44dp" />
            <TextView
                android:id="@+id/listeningText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Listening · tap anywhere to send"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button android:id="@+id/cancelTalkBtn" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="20dp" android:minWidth="110dp" android:background="@drawable/button_bg" android:text="Cancel" android:textColor="@color/muted" android:textSize="17sp" android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
