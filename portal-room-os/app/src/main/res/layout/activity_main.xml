<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:17"
                android:textColor="@color/text"
                android:textSize="48sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monday, September 7"
                android:textColor="@color/muted"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="62° · Clear"
                android:textColor="@color/text"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/presence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room active"
                android:textColor="@color/success"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="26dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOCUS"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/focus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Build the life that deserves your attention."
                android:textColor="@color/text"
                android:textSize="29sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="NEXT"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/nextEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="9:00 · Morning planning"
                android:textColor="@color/text"
                android:textSize="21sp" />
            <TextView
                android:id="@+id/reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Remember: school pickup at 4:01"
                android:textColor="@color/muted"
                android:textSize="17sp" />
        </LinearLayout>

        <Space android:layout_width="18dp" android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/timerCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.8"
                android:background="@drawable/panel_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <com.portalroomos.TimerProgressView
                    android:id="@+id/timerRing"
                    android:layout_width="104dp"
                    android:layout_height="104dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="18dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/timerPhase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="FOCUS"
                        android:textColor="@color/amber"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/timerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="12:04"
                        android:textColor="@color/text"
                        android:textSize="44sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/timerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text=""
                        android:textColor="@color/muted"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
            <Space android:id="@+id/timerSpace" android:layout_width="1dp" android:layout_height="18dp" android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/panel_bg"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOME"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/homeSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Living room · 2 lights on\nThermostat · 70°\nFront door · Locked"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.72"
                android:background="@drawable/panel_bg"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/music"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nothing playing"
                    android:textColor="@color/text"
                    android:textSize="19sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">
        <Button android:id="@+id/voice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="10dp" android:background="@drawable/button_bg" android:text="Talk" android:textColor="@color/text" android:textSize="18sp" android:textAllCaps="false" />
        <Button android:id="@+id/lights" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="10dp" android:background="@drawable/button_bg" android:text="Lights" android:textColor="@color/text" android:textSize="18sp" android:textAllCaps="false" />
        <Button android:id="@+id/musicBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="10dp" android:background="@drawable/button_bg" android:text="Music" android:textColor="@color/text" android:textSize="18sp" android:textAllCaps="false" />
        <Button android:id="@+id/calendarBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="10dp" android:background="@drawable/button_bg" android:text="Calendar" android:textColor="@color/text" android:textSize="18sp" android:textAllCaps="false" />
        <Button android:id="@+id/transitBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="10dp" android:background="@drawable/button_bg" android:text="Transit" android:textColor="@color/text" android:textSize="18sp" android:textAllCaps="false" />
        <Button android:id="@+id/timerBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="10dp" android:background="@drawable/button_bg" android:text="Timer" android:textColor="@color/text" android:textSize="18sp" android:textAllCaps="false" />
        <Button android:id="@+id/add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="10dp" android:background="@drawable/button_bg" android:text="Add" android:textColor="@color/text" android:textSize="18sp" android:textAllCaps="false" />
        <Button android:id="@+id/portalBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/button_bg" android:text="Portal" android:textColor="@color/muted" android:textSize="18sp" android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/chip_bg"
        android:text="Room Brain: connecting…"
        android:textColor="@color/muted"
        android:textSize="13sp" />
</LinearLayout>
