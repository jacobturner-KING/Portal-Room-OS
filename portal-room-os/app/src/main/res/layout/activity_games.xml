<!-- Two layers. The picker is an ordinary Room OS screen: a bar with the
     controller status and a pairing shortcut, then one card per game. A game
     runs in the WebView over the whole panel, with a small chip back to the
     picker (the Portal has no back key). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button android:id="@+id/backBtn" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="56dp" android:background="@drawable/button_bg" android:text="‹" android:textColor="@color/text" android:textSize="24sp" android:textAllCaps="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Games"
                android:textColor="@color/text"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/padText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="15sp" />
            <Button android:id="@+id/pairBtn" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="96dp" android:paddingHorizontal="18dp" android:background="@drawable/button_bg" android:text="Pair controller" android:textColor="@color/text" android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gameRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Tap a game, or pick one with the D-pad and ✕. In a game, the PS or Home button comes back here."
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/exitChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:alpha="0.7"
        android:background="@drawable/chip_bg"
        android:gravity="center"
        android:minWidth="56dp"
        android:minHeight="40dp"
        android:paddingHorizontal="12dp"
        android:text="‹ Games"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
